<UserControl x:Class="MiniProject_GUI.Views.EventLogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" Cursor="Hand">

    <!--
        DataContext = EventLogViewModel (code-behind에서 설정)
        이전: DataContext=this → {Binding EventLogVM.Logs}
        현재: DataContext=EventLogViewModel → {Binding Logs}
    -->

    <GroupBox Header="이벤트 로그" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Style="{StaticResource MaterialDesignCardGroupBox}">
        <ScrollViewer materialDesign:ScrollViewerAssist.PaddingMode="Content"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="Yellow"
                                           Margin="0,0,5,0"
                                           Text="{Binding Time}"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           Text="{Binding Message}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </GroupBox>
</UserControl>
