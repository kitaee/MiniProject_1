			<NOM:parameter name="MissleID" semantics="MissleID" dataType="uint"/>
		</NOM:interaction>

		<NOM:interaction name="LaunchMissile" id="4301" semantics="발사대→유도탄 발사 정보" sharing="PublishSubscribe" orderType="Receive" alignment="false">
