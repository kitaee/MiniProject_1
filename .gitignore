# =============================================================================
# SimulatorSuite .gitignore
# Multi-simulator nFramework C++ solution (tcc, ats, lcs, mfrs, mss) + TCC_GUI
# =============================================================================
# UTF-8
#
# 유지(커밋 대상): 소스(.h/.cpp/.cs/.xaml), 프로젝트 파일, bin/ 설정 스텁(.ini/.xml/.xsd),
#   docs/, design/, ICD/, README, Directory.Build.props, tools/*.ps1
# 제외: 빌드 산출물, IDE/OS 임시 파일, SDK 복사본, 로그, 에이전트 임시 파일
# =============================================================================

# -----------------------------------------------------------------------------
# Visual Studio / MSVC IDE
# -----------------------------------------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.ncb
*.opendb
*.VC.db
*.VC.VC.opendb
*.sdf
*.opensdf
ipch/
*.aps
*.pch

# -----------------------------------------------------------------------------
# C++ build output directories
# -----------------------------------------------------------------------------
**/[Dd]ebug/
**/[Rr]elease/
**/x64/
**/x86/
**/Win32/
**/ARM/
**/ARM64/
**/out/

# -----------------------------------------------------------------------------
# C++ build artifacts (intermediate & linked output)
# -----------------------------------------------------------------------------
*.obj
*.iobj
*.ipdb
*.pdb
*.ilk
*.exp
*.idb
*.lib
*.dll
*.exe
*.tlog
*.lastbuildstate
*.recipe
*.manifest
*.res
*.bsc
*.sbr
*.cache
*.metagen
*.metaproj
*.metaproj.tmp

# -----------------------------------------------------------------------------
# Simulator deployment bin/ — ignore binaries, KEEP config stubs
# (INI, XML, XSD stubs such as CommLinkInfo.ini, SchemaRegistryData.xml, NOM.xsd)
# -----------------------------------------------------------------------------
**/bin/**
!**/bin/
!**/bin/**/
!**/bin/**/*.ini
!**/bin/**/*.xml
!**/bin/**/*.xsd

# -----------------------------------------------------------------------------
# Import libraries (per-simulator lib/ build output)
# -----------------------------------------------------------------------------
**/lib/

# -----------------------------------------------------------------------------
# .NET 8 — TCC_GUI (WPF); output deploys to tcc/bin/
# -----------------------------------------------------------------------------
**/TCC_GUI/bin/
**/TCC_GUI/obj/
**/TCC_GUI/**/*.user

# NuGet
packages/
project.lock.json
**/obj/project.assets.json
**/obj/*.nuget.cache
**/obj/*.nuget.g.props
**/obj/*.nuget.g.targets

# -----------------------------------------------------------------------------
# nFramework SDK junction (frameworks/nFramework_sdk → external SDK)
# Ignore if the junction is replaced by a full SDK copy; keep placeholder only.
# -----------------------------------------------------------------------------
frameworks/nFramework_sdk/**

# -----------------------------------------------------------------------------
# Logs & parser output
# -----------------------------------------------------------------------------
*.log
LogsOfNOMParser/

# -----------------------------------------------------------------------------
# IntelliVal code generation (regenerated at build)
# -----------------------------------------------------------------------------
*IntelliVal.h
*IntelliVal.cs

# -----------------------------------------------------------------------------
# OS-generated files
# -----------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# -----------------------------------------------------------------------------
# Other IDEs & editors
# -----------------------------------------------------------------------------
.idea/
*.swp
*.swo
*~
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -----------------------------------------------------------------------------
# Agent / automation / temporary files
# -----------------------------------------------------------------------------
.cursor/
*.tmp
*.temp
*.bak
*.orig
*.rej
.agent/
