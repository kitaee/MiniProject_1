<Window x:Class="TCC_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCC - 지대공유도탄체계 교전모의"
        Height="820"
        Width="1280"
        MinHeight="720"
        MinWidth="1120"
        FontFamily="Malgun Gothic"
        Background="#E5E7EB">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0369A1"/>
            <Setter Property="Background" Value="#0284C7"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="Background" Value="#DC2626"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="156"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0F172A"
                BorderBrush="#0F172A"
                BorderThickness="1">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Text="TCC"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>
                    <TextBlock Text="지대공유도탄체계 교전모의"
                               Margin="14,4,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#CBD5E1"/>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           Width="520"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="nFConnect 시작 중..."
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Foreground="#BAE6FD"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="294"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="시나리오 입력"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="위협 ID"/>
                            <TextBox x:Name="AirthreatIdTextBox" Grid.Row="0" Grid.Column="1" Text="1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="위협 속도(m/s)"/>
                            <TextBox x:Name="AirthreatVelocityTextBox" Grid.Row="1" Grid.Column="1" Text="300"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="시작 위도"/>
                            <TextBox x:Name="StartLatitudeTextBox" Grid.Row="2" Grid.Column="1" Text="37.5000"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="시작 경도"/>
                            <TextBox x:Name="StartLongitudeTextBox" Grid.Row="3" Grid.Column="1" Text="127.0000"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="종료 위도"/>
                            <TextBox x:Name="EndLatitudeTextBox" Grid.Row="4" Grid.Column="1" Text="37.6000"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="종료 경도"/>
                            <TextBox x:Name="EndLongitudeTextBox" Grid.Row="5" Grid.Column="1" Text="127.1000"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="레이다 위도"/>
                            <TextBox x:Name="RadarLatitudeTextBox" Grid.Row="6" Grid.Column="1" Text="37.5500"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="레이다 경도"/>
                            <TextBox x:Name="RadarLongitudeTextBox" Grid.Row="7" Grid.Column="1" Text="127.0500"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="발사대 위도"/>
                            <TextBox x:Name="LauncherLatitudeTextBox" Grid.Row="8" Grid.Column="1" Text="37.5200"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="발사대 경도"/>
                            <TextBox x:Name="LauncherLongitudeTextBox" Grid.Row="9" Grid.Column="1" Text="127.0200"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="유도탄 설정"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="유도탄 ID"/>
                            <TextBox x:Name="MissileIdTextBox" Grid.Row="0" Grid.Column="1" Text="1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="발사 수량"/>
                            <TextBox x:Name="LaunchCountTextBox" Grid.Row="1" Grid.Column="1" Text="1"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="통제 명령"/>
                        <Button x:Name="DeployScenarioButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="시나리오 배포"
                                Click="DeployScenarioButton_Click"/>
                        <Button x:Name="StartSimulationButton"
                                Content="모의 시작"
                                Click="StartSimulationButton_Click"/>
                        <Button x:Name="StopSimulationButton"
                                Content="모의 중지"
                                Click="StopSimulationButton_Click"/>
                        <Button x:Name="LaunchMissileButton"
                                Style="{StaticResource DangerButton}"
                                Content="유도탄 발사"
                                IsEnabled="False"
                                Click="LaunchMissileButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="14,0">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="교전상황도"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="대한민국 기준 위경도 좌표"
                                       FontSize="11"
                                       Foreground="#64748B"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ATS"
                                       Margin="0,0,8,0"
                                       Foreground="#DC2626"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="MFRS"
                                       Margin="0,0,8,0"
                                       Foreground="#0284C7"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="LCS/MSS"
                                       Foreground="#16A34A"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1"
                            Margin="14,0,14,14"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            Background="#EAF3F8">
                        <Canvas x:Name="MapCanvas"
                                ClipToBounds="True"
                                SizeChanged="MapCanvas_SizeChanged">
                            <Canvas x:Name="MapBackground" IsHitTestVisible="False"/>

                            <Path x:Name="RadarSectorPath"
                                  Stroke="#0284C7"
                                  StrokeThickness="1.6"
                                  Fill="#220284C7"/>
                            <Line x:Name="ThreatPathLine"
                                  Stroke="#475569"
                                  StrokeThickness="2"
                                  StrokeDashArray="6 5"/>
                            <Polyline x:Name="ThreatTrackLine"
                                      Stroke="#DC2626"
                                      StrokeThickness="4"
                                      StrokeLineJoin="Round"/>
                            <Polyline x:Name="MissileTrackLine"
                                      Stroke="#16A34A"
                                      StrokeThickness="4"
                                      StrokeDashArray="6 4"
                                      StrokeLineJoin="Round"/>
                            <Line x:Name="GuidanceLine"
                                  Stroke="#475569"
                                  StrokeThickness="1.4"
                                  StrokeDashArray="3 5"
                                  Visibility="Collapsed"/>

                            <Ellipse x:Name="RadarMarker"
                                     Width="18"
                                     Height="18"
                                     Fill="#0284C7"
                                     Stroke="White"
                                     StrokeThickness="2"/>
                            <TextBlock x:Name="RadarLabel" Text="MFRS" FontWeight="SemiBold" Foreground="#075985"/>

                            <Rectangle x:Name="LauncherMarker"
                                       Width="18"
                                       Height="18"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Fill="#16A34A"
                                       Stroke="White"
                                       StrokeThickness="2"/>
                            <TextBlock x:Name="LauncherLabel" Text="LCS" FontWeight="SemiBold" Foreground="#166534"/>

                            <Polygon x:Name="ThreatMarker"
                                     Points="9,0 18,22 9,16 0,22"
                                     Fill="#DC2626"
                                     Stroke="White"
                                     StrokeThickness="1.8"
                                     RenderTransformOrigin="0.5,0.5"/>
                            <TextBlock x:Name="ThreatLabel" Text="ATS" FontWeight="SemiBold" Foreground="#991B1B"/>

                            <Ellipse x:Name="MissileMarker"
                                     Width="16"
                                     Height="16"
                                     Fill="#22C55E"
                                     Stroke="White"
                                     StrokeThickness="2"/>
                            <TextBlock x:Name="MissileLabel" Text="MSS" FontWeight="SemiBold" Foreground="#166534"/>

                            <Ellipse x:Name="BlastMarker"
                                     Width="34"
                                     Height="34"
                                     Fill="#33FACC15"
                                     Stroke="#CA8A04"
                                     StrokeThickness="3"
                                     Visibility="Collapsed"/>
                            <TextBlock x:Name="BlastLabel"
                                       Text="격추"
                                       FontWeight="Bold"
                                       Foreground="#854D0E"
                                       Visibility="Collapsed"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="전시 상태"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="교전"/>
                        <TextBlock x:Name="EngagementStateText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" Text="대기"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="탐지"/>
                        <TextBlock x:Name="DetectionStateText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="미수신"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="위협"/>
                        <TextBlock x:Name="ThreatStateText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="미배포"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="유도탄"/>
                        <TextBlock x:Name="MissileStateText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="대기"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="재고"/>
                        <TextBlock x:Name="InventoryStateText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}" Text="-"/>
                    </Grid>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="전술 부호"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <Ellipse Grid.Row="0" Grid.Column="0" Width="12" Height="12" Fill="#DC2626" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="ATS 공중위협" VerticalAlignment="Center"/>
                        <Ellipse Grid.Row="1" Grid.Column="0" Width="12" Height="12" Fill="#0284C7" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="MFRS 레이다" VerticalAlignment="Center"/>
                        <Ellipse Grid.Row="2" Grid.Column="0" Width="12" Height="12" Fill="#16A34A" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="LCS/MSS 발사대 및 유도탄" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="12,8,0,0"
                           FontWeight="SemiBold"
                           Text="이벤트 로그"/>
                <ListBox x:Name="LogList"
                         Grid.Row="1"
                         Margin="10,0,10,10"
                         BorderBrush="#CBD5E1"
                         Background="#FFFFFF"/>
            </Grid>
        </Border>
    </Grid>
</Window>
