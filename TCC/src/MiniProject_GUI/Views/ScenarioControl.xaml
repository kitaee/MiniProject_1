<UserControl x:Class="MiniProject_GUI.Views.ScenarioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontSize="12"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MapTargetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Background" Value="#2A303A"/>
            <Setter Property="BorderBrush" Value="#5A6472"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RadarTargetButtonStyle" TargetType="Button" BasedOn="{StaticResource MapTargetButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMapTarget}" Value="Radar">
                    <Setter Property="BorderBrush" Value="#4FA3FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRadarLocation}" Value="True">
                    <Setter Property="Background" Value="#167A43"/>
                    <Setter Property="BorderBrush" Value="#34C759"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LauncherTargetButtonStyle" TargetType="Button" BasedOn="{StaticResource MapTargetButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMapTarget}" Value="Launcher">
                    <Setter Property="BorderBrush" Value="#4FA3FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLauncherLocation}" Value="True">
                    <Setter Property="Background" Value="#167A43"/>
                    <Setter Property="BorderBrush" Value="#34C759"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AirthreatStartTargetButtonStyle" TargetType="Button" BasedOn="{StaticResource MapTargetButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMapTarget}" Value="AirthreatStart">
                    <Setter Property="BorderBrush" Value="#4FA3FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAirthreatStartLocation}" Value="True">
                    <Setter Property="Background" Value="#167A43"/>
                    <Setter Property="BorderBrush" Value="#34C759"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AirthreatEndTargetButtonStyle" TargetType="Button" BasedOn="{StaticResource MapTargetButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMapTarget}" Value="AirthreatEnd">
                    <Setter Property="BorderBrush" Value="#4FA3FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAirthreatEndLocation}" Value="True">
                    <Setter Property="Background" Value="#167A43"/>
                    <Setter Property="BorderBrush" Value="#34C759"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="모드" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ModeText}" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center"/>

                    <TextBlock Text="모의 상태" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SimulationStatusText}" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center"/>

                    <TextBlock Text="배포 상태" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DeploymentStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="120"
                            Height="32"
                            Margin="0,0,8,0"
                            Content="시나리오 편집"
                            Command="{Binding EditScenarioCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedSecondaryButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Width="120"
                            Height="32"
                            Content="모의 모드"
                            Command="{Binding SwitchToSimulationModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedSecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="시나리오 정보"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="북위 41.77° ~ 31.80° · 동경 117.29° ~ 138.78°"
                       Foreground="#B7C7D9"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="레이다" Margin="0,0,0,8">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="위도" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding RadarLatitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="경도" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding RadarLongitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="발사대" Margin="0,0,0,8">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="위도" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding LauncherLatitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="경도" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding LauncherLongitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="공중위협" Margin="0,0,0,8">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="시작 위도" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding StartLatitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="시작 경도" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding StartLongitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="도착 위도" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding EndLatitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="도착 경도" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding EndLongitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="속도(m/s)" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" VerticalContentAlignment="Center" Text="{Binding AirthreatVelocityText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="1"
                                Height="38"
                                Margin="0,10,0,0"
                                Content="저장"
                                Command="{Binding SaveScenarioCommand}"
                                Style="{StaticResource MaterialDesignRaisedSecondaryButton}"/>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="입력한 시나리오"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding SavedScenarioSummaryText}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="1"
                                Height="36"
                                Margin="0,10,0,0"
                                Content="배포"
                                Command="{Binding DeployScenarioCommand}"
                                Style="{StaticResource MaterialDesignRaisedSecondaryButton}"/>

                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="72" Margin="0,0,6,0" Command="{Binding SelectRadarCommand}" Style="{StaticResource RadarTargetButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Radar" Width="14" Height="14" Margin="0,0,4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="레이다" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                            <Button Width="72" Margin="0,0,6,0" Command="{Binding SelectLauncherCommand}" Style="{StaticResource LauncherTargetButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="RocketLaunch" Width="14" Height="14" Margin="0,0,4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="발사대" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                            <Button Width="90" Margin="0,0,6,0" Command="{Binding SelectAirthreatStartCommand}" Style="{StaticResource AirthreatStartTargetButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AirplaneTakeoff" Width="14" Height="14" Margin="0,0,4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="위협 시작" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                            <Button Width="90" Command="{Binding SelectAirthreatEndCommand}" Style="{StaticResource AirthreatEndTargetButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Target" Width="14" Height="14" Margin="0,0,4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="위협 도착" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text="{Binding SelectedMapTargetText, StringFormat=지도 클릭 대상: {0}}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="4"
                        ClipToBounds="True">
                    <Grid>
                        <gmap:GMapControl x:Name="ScenarioMap"
                                          MouseLeftButtonDown="ScenarioMap_MouseLeftButtonDown"/>

                        <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="10">
                            <Button Width="36"
                                    Height="32"
                                    Margin="0,0,0,6"
                                    Click="ZoomIn_Click">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                            </Button>
                            <Button Width="36"
                                    Height="32"
                                    Click="ZoomOut_Click">
                                <materialDesign:PackIcon Kind="Minus" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
