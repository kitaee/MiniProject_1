<UserControl x:Class="MiniProject_GUI.Views.ScenarioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">

    <!--
    ┌──────────────────────────────────────────────────────────────────────────┐
    │    MVVM Binding 구조                                       │
    │                                                                          │
    │  DataContext = AckStatusViewModel (code-behind에서 설정)                  │
    │                                                                          │
    │  이전 혼합형:                                                               │
    │    DataContext = View 자신(this)                                          │
    │    {Binding AckVM.IsAtsAckReceived}  ← View 속성 → ViewModel 경유         │
    │    Click="OnCheckAtsConnectionClick"  ← code-behind에 실행 로직            │
    │                                                                          │
    │  현재 MVVM:                                                                │
    │    DataContext = AckStatusViewModel                                       │
    │    {Binding IsAtsAckReceived}  ← ViewModel 속성에 직접 바인딩              │
    │    Command="{Binding CheckAtsConnectionCommand}"  ← ViewModel의 Command  │
    │                                                                          │
    │  View는 "무엇을 보여줄지"만 선언한다. "어떻게 동작할지"는 ViewModel이 결정.  │
    └──────────────────────────────────────────────────────────────────────────┘
    -->

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <GroupBox HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Header="ATS 연동 확인"
                  Style="{StaticResource MaterialDesignCardGroupBox}">

            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10">

                <!--
                      ICommand Binding
                    Command="{Binding CheckAtsConnectionCommand}"
                      → DataContext(AckStatusViewModel)의 CheckAtsConnectionCommand 속성을 찾는다.
                      → 버튼 클릭 시 RelayCommand.Execute() → ExecuteCheckAtsConnection() 호출
                      → code-behind에 Click 핸들러가 없어도 동작한다.
                -->
                <Button Height="40"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                        Command="{Binding CheckAtsConnectionCommand}">
                    <TextBlock Text="ATS 연동 확인"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <!--
                    ATS 연동 상태 표시등
                    ─────────────────────────────────────────────────────────────
                      DataTrigger 직접 바인딩

                    이전: {Binding AckVM.IsAtsAckReceived}
                      DataContext=this → View의 AckVM 속성 → ViewModel.IsAtsAckReceived

                    현재: {Binding IsAtsAckReceived}
                      DataContext=AckStatusViewModel → 바로 IsAtsAckReceived

                    DataContext가 ViewModel이므로 경로가 한 단계 짧아진다.
                -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">

                    <Ellipse Width="20" Height="20"
                             Stroke="White" StrokeThickness="1"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAtsAckReceived}" Value="True">
                                        <Setter Property="Fill" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding AtsAckStatusText}"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                </StackPanel>

            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
