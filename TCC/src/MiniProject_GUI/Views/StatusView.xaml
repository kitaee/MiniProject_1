<UserControl x:Class="MiniProject_GUI.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">

    <!--
        DataContext = StatusViewModel (code-behind에서 설정)
        이전: DataContext=this → {Binding StatusVM.IsLauncherConnected}
        현재: DataContext=StatusViewModel → {Binding IsLauncherConnected}
    -->

    <UserControl.Resources>
        <Style x:Key="CircleWithIconStyle" TargetType="Grid">
            <Setter Property="Width" Value="55"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
              DataTrigger with {Binding}
            DataContext가 bool 값 자체인 경우 {Binding}만으로도 값에 바인딩된다.
            Grid의 DataContext를 ViewModel의 bool 속성으로 설정했기 때문이다.
        -->
        <Style x:Key="StatusCircleStyle" TargetType="Ellipse">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="0.5"/>
            <Setter Property="Fill" Value="Gray"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Fill" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="False">
                    <Setter Property="Fill" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <GroupBox Header="상태 정보" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Style="{StaticResource MaterialDesignCardGroupBox}">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Text="발사대"/>
                    <!-- Grid의 DataContext를 bool 속성으로 설정 → StatusCircleStyle의 {Binding}이 이 값을 참조 -->
                    <Grid Style="{StaticResource CircleWithIconStyle}"
                          DataContext="{Binding IsLauncherConnected}">
                        <Ellipse Style="{StaticResource StatusCircleStyle}"/>
                        <materialDesign:PackIcon Kind="BowArrow" Style="{StaticResource StatusIconStyle}"/>
                    </Grid>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="White" HorizontalAlignment="Center" Text="유도탄"/>
                    <Grid Style="{StaticResource CircleWithIconStyle}"
                          DataContext="{Binding IsMissileConnected}">
                        <Ellipse Style="{StaticResource StatusCircleStyle}"/>
                        <materialDesign:PackIcon Kind="RocketLaunch" Style="{StaticResource StatusIconStyle}"/>
                    </Grid>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="White" HorizontalAlignment="Center" Text="레이다"/>
                    <Grid Style="{StaticResource CircleWithIconStyle}"
                          DataContext="{Binding IsRadarConnected}">
                        <Ellipse Style="{StaticResource StatusCircleStyle}"/>
                        <materialDesign:PackIcon Kind="Radar" Style="{StaticResource StatusIconStyle}" Margin="0,0,0,10" VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="White" HorizontalAlignment="Center" Text="공중위협"/>
                    <Grid Style="{StaticResource CircleWithIconStyle}"
                          DataContext="{Binding IsAirThreatConnected}">
                        <Ellipse Style="{StaticResource StatusCircleStyle}"/>
                        <materialDesign:PackIcon Kind="Airplane" Style="{StaticResource StatusIconStyle}"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Grid>
    </GroupBox>
</UserControl>
