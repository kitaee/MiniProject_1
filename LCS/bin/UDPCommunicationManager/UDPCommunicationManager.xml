			<NOM:parameter name="LCSYPos" semantics="LCSYPos" dataType="float"/>
		</NOM:interaction>

		<NOM:interaction name="MissileQuantityInfo" id="4102" semantics="발사대→통합통제기 유도탄 재고" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
			<NOM:parameter name="MissileQuantity" semantics="MissileQuantity" dataType="uint"/>
		</NOM:interaction>

		<NOM:interaction name="UplinkInfo" id="5301" semantics="레이더 모의기(유도탄 모의기) 업링크(주기)->유도탄" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
			<NOM:parameter name="UplinkInfo" semantics="UplinkInfo" dataType="UplinkInfoStruct"/>
		</NOM:interaction>

