<?xml version="1.0" encoding="UTF-8"?>
<NOM:Nex1ObjectModel xmlns:NOM="lignex1.sw.nframework.NOM"
                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xsi:schemaLocation="lignex1.sw.nframework.NOM NOM.xsd"
                     version="0.1"
                     name="MSSCommandManager"
                     date="2026-06-23"
                     author="SimulatorSuite">

	<NOM:objects>
	</NOM:objects>

	<NOM:interactions>

		<!-- ========================================================= -->
		<!-- UDPCommunicationManager -> MSSCommandManager              -->
		<!-- 외부 ICD 메시지를 내부 메시지로 변환하여 Command로 전달   -->
		<!-- ========================================================= -->

		<!-- 시나리오 정보 수신: DeployScenarioRequest 본문 구조 유지 -->
		<NOM:interaction name="InnerSendScenario" id="9001" semantics="Receive scenario data from UDPCommunicationManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="Airthreat" semantics="Airthreat" dataType="AirthreatStruct"/>
			<NOM:parameter name="RadarXPos" semantics="RadarXPos" dataType="float"/>
			<NOM:parameter name="RadarYPos" semantics="RadarYPos" dataType="float"/>
			<NOM:parameter name="LauncherXPos" semantics="LauncherXPos" dataType="float"/>
			<NOM:parameter name="LauncherYPos" semantics="LauncherYPos" dataType="float"/>
			<NOM:parameter name="MissileVelocity" semantics="MissileVelocity" dataType="float"/>
		</NOM:interaction>

		<!-- 모의 시작/중지 명령 수신 -->
		<NOM:interaction name="InnerStartSimulation" id="9005" semantics="Receive start simulation command from UDPCommunicationManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>
		<NOM:interaction name="InnerStopSimulation" id="9006" semantics="Receive stop simulation command from UDPCommunicationManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>

		<!-- 발사 명령 수신: LaunchMissile 구조 유지 -->
		<NOM:interaction name="InnerLaunchMissile" id="9009" semantics="Receive launch missile command from UDPCommunicationManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="AirthreatID" semantics="AirthreatID" dataType="uint"/>
			<NOM:parameter name="AirthreatXPos" semantics="AirthreatXpos" dataType="float"/>
			<NOM:parameter name="AirthreatYPos" semantics="AirthreatYPos" dataType="float"/>
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="LCSXPos" semantics="LCSXPos" dataType="float"/>
			<NOM:parameter name="LCSYPos" semantics="LCSYPos" dataType="float"/>
		</NOM:interaction>

		<!-- 업링크 정보 수신: UplinkInfo 구조 유지 -->
		<NOM:interaction name="InnerUplinkInfo" id="9011" semantics="Receive uplink information from UDPCommunicationManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="UplinkInfo" semantics="UplinkInfo" dataType="UplinkInfoStruct"/>
		</NOM:interaction>


		<!-- ========================================================= -->
		<!-- MSSCommandManager -> MSSModelManager                      -->
		<!-- Command는 데이터를 해석하지 않고 Model로 그대로 중계       -->
		<!-- ========================================================= -->

		<!-- 시나리오 정보 모델 전달: InnerSendScenario와 동일 필드 -->
		<NOM:interaction name="InnerSendScenarioToModel" id="9002" semantics="Forward scenario data to MSSModelManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="Airthreat" semantics="Airthreat" dataType="AirthreatStruct"/>
			<NOM:parameter name="RadarXPos" semantics="RadarXPos" dataType="float"/>
			<NOM:parameter name="RadarYPos" semantics="RadarYPos" dataType="float"/>
			<NOM:parameter name="LauncherXPos" semantics="LauncherXPos" dataType="float"/>
			<NOM:parameter name="LauncherYPos" semantics="LauncherYPos" dataType="float"/>
			<NOM:parameter name="MissileVelocity" semantics="MissileVelocity" dataType="float"/>
		</NOM:interaction>

		<!-- 모의 시작/중지 모델 전달 -->
		<NOM:interaction name="InnerStartSimulationToModel" id="9007" semantics="Forward start simulation command to MSSModelManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>
		<NOM:interaction name="InnerStopSimulationToModel" id="9008" semantics="Forward stop simulation command to MSSModelManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>

		<!-- 발사 명령 모델 전달: InnerLaunchMissile와 동일 필드 -->
		<NOM:interaction name="InnerLaunchMissileToModel" id="9010" semantics="Forward launch missile command to MSSModelManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="AirthreatID" semantics="AirthreatID" dataType="uint"/>
			<NOM:parameter name="AirthreatXPos" semantics="AirthreatXpos" dataType="float"/>
			<NOM:parameter name="AirthreatYPos" semantics="AirthreatYPos" dataType="float"/>
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="LCSXPos" semantics="LCSXPos" dataType="float"/>
			<NOM:parameter name="LCSYPos" semantics="LCSYPos" dataType="float"/>
		</NOM:interaction>

		<!-- 업링크 모델 전달: InnerUplinkInfo와 동일 필드 -->
		<NOM:interaction name="InnerUplinkInfoToModel" id="9012" semantics="Forward uplink information to MSSModelManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="UplinkInfo" semantics="UplinkInfo" dataType="UplinkInfoStruct"/>
		</NOM:interaction>


		<!-- ========================================================= -->
		<!-- MSSModelManager -> MSSCommandManager                      -->
		<!-- Model 처리 결과 수신                                      -->
		<!-- ========================================================= -->

		<!-- 시나리오 초기화 완료 이벤트 -->
		<NOM:interaction name="InnerSendCompleteInitialize" id="9003" semantics="Receive model initialization complete event from MSSModelManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>

		<!-- 다운링크 정보 수신 -->
		<NOM:interaction name="InnerDownlinkInfoFromModel" id="9013" semantics="Receive downlink information from MSSModelManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="DownlinkInfo" semantics="DownlinkInfo" dataType="DownlinkInfoStruct"/>
		</NOM:interaction>

		<!-- 격추 이벤트 수신 -->
		<NOM:interaction name="InnerDetonationEvent" id="9015" semantics="Receive detonation event from MSSModelManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="TargetID" semantics="TargetID" dataType="uint"/>
		</NOM:interaction>


		<!-- ========================================================= -->
		<!-- MSSCommandManager -> UDPCommunicationManager              -->
		<!-- 외부 송신을 위해 UDPCommunicationManager로 전달            -->
		<!-- ========================================================= -->

		<!-- 시나리오 ACK 송신 요청 -->
		<NOM:interaction name="InnerSendScenarioAck" id="9004" semantics="Forward scenario ack to UDPCommunicationManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>

		<!-- 다운링크 외부 송신 요청 -->
		<NOM:interaction name="InnerDownlinkInfo" id="9014" semantics="Forward downlink information to UDPCommunicationManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="DownlinkInfo" semantics="DownlinkInfo" dataType="DownlinkInfoStruct"/>
		</NOM:interaction>

		<!-- 격추 정보 외부 송신 요청 -->
		<NOM:interaction name="InnerDetonationInfo" id="9016" semantics="Forward detonation information to UDPCommunicationManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="TargetID" semantics="TargetID" dataType="uint"/>
		</NOM:interaction>

	</NOM:interactions>

	<NOM:dataTypes>
		<NOM:basicTypes/>
		<NOM:enumerationTypes/>
		<NOM:complexTypes/>
	</NOM:dataTypes>

	<NOM:notes>
	</NOM:notes>
</NOM:Nex1ObjectModel>