<NOM:Nex1ObjectModel xmlns:NOM="lignex1.sw.nframework.NOM" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="lignex1.sw.nframework.NOM NOM.xsd" version="0.1" name="UDPCommunicationManager" date="2026-06-18" author="SimulatorSuite">
	<NOM:objects> </NOM:objects>
	<NOM:interactions>
		<!-- 수신하는 외부 메시지 -->
		<NOM:interaction name="DeployScenarioRequest" id="1001" semantics="통합통제기→모의기 시나리오 배포" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
			<NOM:parameter name="Airthreat" semantics="Airthreat" dataType="AirthreatStruct"/>
			<NOM:parameter name="RadarXPos" semantics="RadarXPos" dataType="float"/>
			<NOM:parameter name="RadarYPos" semantics="RadarYPos" dataType="float"/>
			<NOM:parameter name="LauncherXPos" semantics="LauncherXPos" dataType="float"/>
			<NOM:parameter name="LauncherYPos" semantics="LauncherYPos" dataType="float"/>
			<NOM:parameter name="MissileVelocity" semantics="MissileVelocity" dataType="float"/>
		</NOM:interaction>
		
		<NOM:interaction name="StartSimulationRequest" id="1002" semantics="통합통제기→모의기 시뮬레이션 시작" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
		</NOM:interaction>
		
		<NOM:interaction name="StopSimulationRequest" id="1003" semantics="통합통제기→모의기 시뮬레이션 정지" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
		</NOM:interaction>
		
		<NOM:interaction name="LaunchMissile" id="4301" semantics="발사대→유도탄 발사 정보" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
			<NOM:parameter name="AirthreatID" semantics="AirthreatID" dataType="uint"/>
			<NOM:parameter name="AirthreatXPos" semantics="AirthreatXpos" dataType="float"/>
			<NOM:parameter name="AirthreatYPos" semantics="AirthreatYPos" dataType="float"/>
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="LCSXPos" semantics="LCSXpos" dataType="float"/>
			<NOM:parameter name="LCSYPos" semantics="LCSYPos" dataType="float"/>
		</NOM:interaction>

		<NOM:interaction name="UplinkInfoToMSS" id="5301" semantics="MFRS -> MSS uplink information" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
			<NOM:parameter name="UplinkInfo" semantics="UplinkInfo" dataType="UplinkInfoStruct"/>
		</NOM:interaction>
		<!-- 송신할 외부 메시지 -->
		<NOM:interaction name="ScenarioACK" id="3101" semantics="각 모의기→통합통제기 시나리오 ACK" sharing="Publish" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
		</NOM:interaction>

		<NOM:interaction name="DownlinkInfoFromMSS" id="3501" semantics="MSS -> MFRS downlink information" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
			<NOM:parameter name="DownlinkInfo" semantics="DownlinkInfo" dataType="DownlinkInfoStruct"/>
		</NOM:interaction>

		<NOM:interaction name="DetonationInfo" id="3201" semantics="유도탄→공중위협 요격 결과" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MessageHeader" semantics="MessageHeader" dataType="MessageHeaderStruct"/>
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="TargetID" semantics="TargetID" dataType="uint"/>
		</NOM:interaction>

		<!-- 송신할 내부 메시지 -->
		
		<!-- 시나리오 정보 CommandManager 전달  -->
		<NOM:interaction name="InnerSendScenario" id="9001" semantics="Internal scenario message to command manager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="Airthreat" semantics="Airthreat" dataType="AirthreatStruct"/>
			<NOM:parameter name="RadarXPos" semantics="RadarXPos" dataType="float"/>
			<NOM:parameter name="RadarYPos" semantics="RadarYPos" dataType="float"/>
			<NOM:parameter name="LauncherXPos" semantics="LauncherXPos" dataType="float"/>
			<NOM:parameter name="LauncherYPos" semantics="LauncherYPos" dataType="float"/>
			<NOM:parameter name="MissileVelocity" semantics="MissileVelocity" dataType="float"/>
		</NOM:interaction>
		<!-- 모의 시작/중지 CommandManager 전달 -->
		<NOM:interaction name="InnerStartSimulation" id="9005" semantics="Internal start simulation message to command manager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>
		<NOM:interaction name="InnerStopSimulation" id="9006" semantics="Internal stop simulation message to command manager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>
		<!-- 발사 명령 CommandManager 전달 -->
		<NOM:interaction name="InnerLaunchMissile" id="9009" semantics="Internal launch missile message to command manager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="AirthreatID" semantics="AirthreatID" dataType="uint"/>
			<NOM:parameter name="AirthreatXPos" semantics="AirthreatXPos" dataType="float"/>
			<NOM:parameter name="AirthreatYPos" semantics="AirthreatYPos" dataType="float"/>
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="LCSXPos" semantics="LCSXpos" dataType="float"/>
			<NOM:parameter name="LCSYPos" semantics="LCSYPos" dataType="float"/>
		</NOM:interaction>
		<!-- 업링크 정보 CommandManager 전달 -->
		<NOM:interaction name="InnerUplinkInfo" id="9011" semantics="Internal uplink info message to command manager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="UplinkInfo" semantics="UplinkInfo" dataType="UplinkInfoStruct"/>
		</NOM:interaction>
		
		<!-- 수신하는 내부 메시지 -->
		
		<!-- 시나리오ACK 외부 전달 -->
		<NOM:interaction name="InnerSendScenarioAck" id="9004" semantics="Internal scenario ack message to communication manager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>
		<!-- 다운링크 정보 외부 전달 -->
		<NOM:interaction name="InnerDownlinkInfo" id="9014" semantics="Internal downlink info message to communication manager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="DownlinkInfo" semantics="DownlinkInfo" dataType="DownlinkInfoStruct"/>
		</NOM:interaction>
		<!-- 격추 정보 외부 전달 -->
		<NOM:interaction name="InnerDetonationInfo" id="9016" semantics="Internal detonation info message to communication manager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="TargetID" semantics="TargetID" dataType="uint"/>
		</NOM:interaction>
	</NOM:interactions>
	<NOM:dataTypes>
		<NOM:basicTypes/>
		<NOM:enumerationTypes/>
		<NOM:complexTypes/>
	</NOM:dataTypes>
	<NOM:notes> </NOM:notes>
</NOM:Nex1ObjectModel>