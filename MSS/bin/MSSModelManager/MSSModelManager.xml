<?xml version="1.0" encoding="UTF-8"?>
<NOM:Nex1ObjectModel xmlns:NOM="lignex1.sw.nframework.NOM"
                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xsi:schemaLocation="lignex1.sw.nframework.NOM NOM.xsd"
                     version="0.1"
                     name="MSSModelManager"
                     date="2026-06-23"
                     author="SimulatorSuite">

	<NOM:objects>
	</NOM:objects>

	<NOM:interactions>

		<!-- ========================================================= -->
		<!-- MSSCommandManager -> MSSModelManager                      -->
		<!-- 모델이 실제로 파싱하고 사용할 내부 입력 메시지             -->
		<!-- ========================================================= -->

		<!-- 시나리오 정보 수신 => 속력만 파싱해서 초기화-->
		<NOM:interaction name="InnerSendScenarioToModel" id="9002" semantics="Receive scenario data from MSSCommandManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="Airthreat" semantics="Airthreat" dataType="AirthreatStruct"/>
			<NOM:parameter name="RadarXPos" semantics="RadarXPos" dataType="float"/>
			<NOM:parameter name="RadarYPos" semantics="RadarYPos" dataType="float"/>
			<NOM:parameter name="LauncherXPos" semantics="LauncherXPos" dataType="float"/>
			<NOM:parameter name="LauncherYPos" semantics="LauncherYPos" dataType="float"/>
			<NOM:parameter name="MissileVelocity" semantics="MissileVelocity" dataType="float"/>
		</NOM:interaction>

		<!-- 모의 시작/중지 수신 => 속력 및 위치 값 초기화(또는 객체 제거) -->
		<NOM:interaction name="InnerStartSimulationToModel" id="9007" semantics="Receive start simulation command from MSSCommandManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>
		<NOM:interaction name="InnerStopSimulationToModel" id="9008" semantics="Receive stop simulation command from MSSCommandManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>

		<!-- 발사 명령 수신 => 초기 단위 속도 벡터 설정 -->
		<NOM:interaction name="InnerLaunchMissileToModel" id="9010" semantics="Receive launch missile command from MSSCommandManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="AirthreatID" semantics="AirthreatID" dataType="uint"/>
			<NOM:parameter name="AirthreatXPos" semantics="AirthreatXpos" dataType="float"/>
			<NOM:parameter name="AirthreatYPos" semantics="AirthreatYPos" dataType="float"/>
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="LCSXPos" semantics="LCSXPos" dataType="float"/>
			<NOM:parameter name="LCSYPos" semantics="LCSYPos" dataType="float"/>
		</NOM:interaction>

		<!-- 업링크 정보 수신 => 표적 정보 초기화 -->
		<NOM:interaction name="InnerUplinkInfoToModel" id="9012" semantics="Receive uplink information from MSSCommandManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="UplinkInfo" semantics="UplinkInfo" dataType="UplinkInfoStruct"/>
		</NOM:interaction>


		<!-- ========================================================= -->
		<!-- MSSModelManager -> MSSCommandManager                      -->
		<!-- 모델 처리 결과 전달                                       -->
		<!-- ========================================================= -->

		<!-- 시나리오 초기화 완료 -->
		<NOM:interaction name="InnerSendCompleteInitialize" id="9003" semantics="Send model initialization complete event to MSSCommandManager" sharing="PublishSubscribe" orderType="Receive" alignment="false"/>

		<!-- 다운링크 정보 생성 결과 -->
		<NOM:interaction name="InnerDownlinkInfoFromModel" id="9013" semantics="Send downlink information to MSSCommandManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="DownlinkInfo" semantics="DownlinkInfo" dataType="DownlinkInfoStruct"/>
		</NOM:interaction>

		<!-- 격추 이벤트 생성 결과 -->
		<NOM:interaction name="InnerDetonationEvent" id="9015" semantics="Send detonation event to MSSCommandManager" sharing="PublishSubscribe" orderType="Receive" alignment="false">
			<NOM:parameter name="MissileID" semantics="MissileID" dataType="uint"/>
			<NOM:parameter name="TargetID" semantics="TargetID" dataType="uint"/>
		</NOM:interaction>

	</NOM:interactions>

	<NOM:dataTypes>
		<NOM:basicTypes/>
		<NOM:enumerationTypes/>
		<NOM:complexTypes/>
	</NOM:dataTypes>

	<NOM:notes>
	</NOM:notes>
</NOM:Nex1ObjectModel>